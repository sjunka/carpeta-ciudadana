# Copiar a .env (no se versiona). Valores solo para desarrollo local.
PG_CLAVE=cambia-esta-clave
S3_ACCESS_KEY=mcs-local
S3_SECRET_KEY=cambia-esta-clave-s3
KC_ADMIN_CLAVE=cambia-esta-clave-admin
KC_AFILIACION_SECRETO=cambia-este-secreto
# operatorId que devuelve GovCarpeta al registrar «Mi Carpeta Segura» (npm run registrar-operador)
OPERADOR_ID=
# Clave entre custodia y las rutas internas de afiliación (traslado entre operadores)
CLAVE_INTERNA=cambia-esta-clave-interna
# URL pública de custodia que verán los otros operadores (https en la nube)
URL_PUBLICA=http://localhost:8083
